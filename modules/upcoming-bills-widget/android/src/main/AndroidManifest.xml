<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="expo.modules.upcomingbillswidget.UpcomingBillsWidgetProvider"
            android:exported="true"
            android:label="@string/upcoming_bills_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/upcoming_bills_widget_info" />
        </receiver>

        <service
            android:name="expo.modules.upcomingbillswidget.UpcomingBillsWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>
</manifest>
