<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/upcoming_bills_widget_background"
    android:clipToOutline="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/upcoming_bills_widget_header"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/upcoming_bills_widget_ripple"
        android:contentDescription="@string/upcoming_bills_widget_header_description"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:importantForAccessibility="no"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:text="@string/upcoming_bills_widget_header"
            android:textColor="@color/upcoming_bills_widget_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/upcoming_bills_widget_late"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/upcoming_bills_widget_overdue"
            android:textSize="11sp"
            android:visibility="gone" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/upcoming_bills_widget_ic_chevron_right"
            android:tint="@color/upcoming_bills_widget_text_secondary"
            tools:ignore="UseAppTint" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/upcoming_bills_widget_border" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/upcoming_bills_widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/upcoming_bills_widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/upcoming_bills_widget_ripple"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/upcoming_bills_widget_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/upcoming_bills_widget_empty_unloaded_title"
                android:textColor="@color/upcoming_bills_widget_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/upcoming_bills_widget_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/upcoming_bills_widget_empty_unloaded_text"
                android:textColor="@color/upcoming_bills_widget_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
