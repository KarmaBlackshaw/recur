{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"REPO RULE: before responding, invoke these skills via the Skill tool, in order: using-superpowers, dispatching-parallel-agents,  web-component-design. Skip an invocation only if that skill is already loaded this session.\"}}'",
            "statusMessage": "Loading repo skills"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/obsidian-recall.sh\" SessionStart",
            "statusMessage": "Loading Obsidian memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/obsidian-push.sh\"",
            "statusMessage": "Saving to Obsidian"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(npx expo *)"
    ]
  }
}
