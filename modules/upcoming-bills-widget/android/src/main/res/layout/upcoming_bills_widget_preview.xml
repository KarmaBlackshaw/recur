<?xml version="1.0" encoding="utf-8"?>
<!-- Static sample for the widget picker (android:previewLayout, API 31+). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/upcoming_bills_widget_background"
    android:clipToOutline="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:text="@string/upcoming_bills_widget_header"
            android:textColor="@color/upcoming_bills_widget_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="1 late"
            android:textColor="@color/upcoming_bills_widget_overdue"
            android:textSize="11sp"
            tools:ignore="HardcodedText" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/upcoming_bills_widget_ic_chevron_right"
            android:tint="@color/upcoming_bills_widget_text_secondary"
            tools:ignore="UseAppTint" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/upcoming_bills_widget_border" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical|start"
        android:letterSpacing="0.12"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/upcoming_bills_widget_band_overdue"
        android:textAllCaps="true"
        android:textColor="@color/upcoming_bills_widget_overdue"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/upcoming_bills_widget_tile_negative"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/upcoming_bills_widget_ic_zap"
            android:tint="@color/upcoming_bills_widget_overdue"
            tools:ignore="UseAppTint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Electricity"
                android:textColor="@color/upcoming_bills_widget_text"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Utilities · Checking"
                android:textColor="@color/upcoming_bills_widget_text_secondary"
                android:textSize="11sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="₱2,480.00"
                android:textColor="@color/upcoming_bills_widget_text"
                android:textSize="15sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 days late"
                android:textColor="@color/upcoming_bills_widget_overdue"
                android:textSize="11sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical|start"
        android:letterSpacing="0.12"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/upcoming_bills_widget_band_upcoming"
        android:textAllCaps="true"
        android:textColor="@color/upcoming_bills_widget_text_secondary"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/upcoming_bills_widget_tile_accent"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/upcoming_bills_widget_ic_credit_card"
            android:tint="@color/upcoming_bills_widget_accent"
            tools:ignore="UseAppTint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Visa bill"
                android:textColor="@color/upcoming_bills_widget_text"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="₱8,120.00"
                android:textColor="@color/upcoming_bills_widget_text"
                android:textSize="15sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tomorrow"
                android:textColor="@color/upcoming_bills_widget_text_secondary"
                android:textSize="11sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/upcoming_bills_widget_tile_neutral"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/upcoming_bills_widget_ic_home"
            android:tint="@color/upcoming_bills_widget_text_secondary"
            tools:ignore="UseAppTint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Rent"
                android:textColor="@color/upcoming_bills_widget_text"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Housing · Savings"
                android:textColor="@color/upcoming_bills_widget_text_secondary"
                android:textSize="11sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="₱15,000.00"
                android:textColor="@color/upcoming_bills_widget_text"
                android:textSize="15sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="in 4 days"
                android:textColor="@color/upcoming_bills_widget_text_secondary"
                android:textSize="11sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
